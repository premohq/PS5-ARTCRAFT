From c6489765f4c31f3110d84097999f0cc75619f96e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 03:49:27 +0000
Subject: [PATCH 3/4] explorer: ArtCraft's Start and taskbar keep only File
 Explorer and Settings

The ArtCraft edition's desktop is a closed one for the Craft App Suite: its
apps' shortcuts are on the desktop and pinned in Start by PS5-ARTCRAFT's
session start. Of the built-ins, it keeps the file manager and Settings.

  - Taskbar: PW_TASKBAR_PINS is 2, File Explorer and Settings. The
    prototype's layout (patch 1140) and its flyouts (1161) size themselves
    from PW_TASKBAR_PINS and index no pin by number, so nothing else changes.
  - Start: pw_start_builtin_path() answers no for Notepad, Terminal and
    MihawkBrowser, the one door every use of a built-in goes through: they
    are not listed, not among the default pins, and MihawkBrowser is not
    pinned once (pw_start_pin_browser_once returns at once).

This is the edition branch's own change, unconditional: a build of it is the
ArtCraft shell. tools/run-shell-scorecard.py's taskbar scenarios compare
against the prototype's five pins and will differ.

Proven: the changed table and functions compile with MinGW-w64 GCC 13
(-Wall -Wextra -Werror) in a mock with stub icon and sprite IDs; the real
headers they need (appearance.h, pw_shell_sprites.h) are generated by the
fork's theme build. No console run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ErqzkhbC5fRkeGcCmR5R95
---
 wine/ps5/pw_shell_start.c   | 11 +++++++++--
 wine/ps5/pw_shell_taskbar.h | 16 ++++++++--------
 2 files changed, 17 insertions(+), 10 deletions(-)

diff --git a/wine/ps5/pw_shell_start.c b/wine/ps5/pw_shell_start.c
index 33b0d65..20fce16 100644
--- a/wine/ps5/pw_shell_start.c
+++ b/wine/ps5/pw_shell_start.c
@@ -139,7 +139,7 @@ static BOOL pw_start_save_pins(struct pw_start_state *s)
 /* The built-in apps, in the prototype's pin order (its Calculator has no counterpart here), with its names and the
  * prototype's own icons for them, each a file in a folder (a CSIDL): MihawkBrowser is the Public Desktop shortcut the
  * title keeps pointing at the runtime's copy (native/proton_wine.cpp). */
-enum { PW_START_TERMINAL = 3, PW_START_BROWSER = 4 };
+enum { PW_START_NOTEPAD = 2, PW_START_TERMINAL = 3, PW_START_BROWSER = 4 };
 static const struct { const WCHAR *image, *name; int folder, resource, sprite; } pw_start_builtins[] = {
     {L"explorer.exe", L"File Explorer", CSIDL_WINDOWS, PW_ICON_ORIGINAL_FOLDER_OPEN, PW_SPRITE_START_ICON_EXPLORER},
     {L"mihawk-appearance.exe", L"Settings", CSIDL_SYSTEM, PW_ICON_LIGHT_SETTINGS, PW_SPRITE_START_ICON_SETTINGS},
@@ -147,9 +147,16 @@ static const struct { const WCHAR *image, *name; int folder, resource, sprite; }
     {L"cmd.exe", L"Terminal", CSIDL_SYSTEM, PW_ICON_LIGHT_TERMINAL, PW_SPRITE_START_ICON_TERMINAL},
     {L"MihawkBrowser.lnk", L"MihawkBrowser", CSIDL_COMMON_DESKTOPDIRECTORY, PW_ICON_ORIGINAL_APP_BROWSER, PW_SPRITE_START_ICON_BROWSER},
 };
+/* The ArtCraft edition's Start lists only File Explorer and Settings among the built-ins, as its taskbar pins them
+ * (pw_shell_taskbar.h): a built-in without a path is neither listed nor pinned, nor is MihawkBrowser pinned once. */
+static BOOL pw_start_builtin_shown(unsigned i)
+{
+    return i != PW_START_NOTEPAD && i != PW_START_TERMINAL && i != PW_START_BROWSER;
+}
 static BOOL pw_start_builtin_path(unsigned i, WCHAR *path)
 {
-    return SUCCEEDED(SHGetFolderPathW(NULL, pw_start_builtins[i].folder, NULL, SHGFP_TYPE_CURRENT, path)) &&
+    return pw_start_builtin_shown(i) &&
+           SUCCEEDED(SHGetFolderPathW(NULL, pw_start_builtins[i].folder, NULL, SHGFP_TYPE_CURRENT, path)) &&
            PathAppendW(path, pw_start_builtins[i].image) && GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES;
 }
 /* MihawkBrowser joined the built-ins after Terminal on 2026-10-17: pins saved before then get it there once, and a
diff --git a/wine/ps5/pw_shell_taskbar.h b/wine/ps5/pw_shell_taskbar.h
index c21a517..36d6ab8 100644
--- a/wine/ps5/pw_shell_taskbar.h
+++ b/wine/ps5/pw_shell_taskbar.h
@@ -18,12 +18,15 @@
 #include "pw_taskbar_layout.h"
 #include "pw_taskbar_logo.h"
 
-#define PW_TASKBAR_PINS 5
+#define PW_TASKBAR_PINS 2
 
-/* The prototype's pinned apps (Shell.apps with pinned: true, in its order), as the native Start's built-ins name them.
- * A running window counts as the pin when its process image is the pin's or the pin's console host. A pin starts what
- * launch names in its folder (a CSIDL): the program, or for MihawkBrowser, which lives in the runtime's own folder, the
- * Public Desktop shortcut the title keeps pointing at it (native/proton_wine.cpp). */
+/* The pinned apps, as the native Start's built-ins name them. A running window counts as the pin when its process
+ * image is the pin's or the pin's console host. A pin starts what launch names in its folder (a CSIDL).
+ *
+ * The ArtCraft edition's taskbar pins only the file manager and Settings: its desktop is for the Craft App Suite, whose
+ * own shortcuts are on the desktop and in Start (PS5-ARTCRAFT's session start), and Notepad, Terminal and
+ * MihawkBrowser are not part of it. The prototype's other pins were Notepad, Terminal (console host conhost.exe) and
+ * MihawkBrowser (its Public Desktop shortcut); the layout (Wine patch 1140) sizes itself from PW_TASKBAR_PINS. */
 static const struct pw_taskbar_pin_app
 {
     const WCHAR *name, *image, *host, *launch;
@@ -32,9 +35,6 @@ static const struct pw_taskbar_pin_app
 } pw_taskbar_pin_apps[PW_TASKBAR_PINS] = {
     {L"File Explorer", L"explorer.exe", NULL, L"explorer.exe", CSIDL_WINDOWS, PW_SPRITE_EXPLORER},
     {L"Settings", L"mihawk-appearance.exe", NULL, L"mihawk-appearance.exe", CSIDL_SYSTEM, PW_SPRITE_SETTINGS},
-    {L"Notepad", L"notepad.exe", NULL, L"notepad.exe", CSIDL_SYSTEM, PW_SPRITE_NOTEPAD},
-    {L"Terminal", L"cmd.exe", L"conhost.exe", L"cmd.exe", CSIDL_SYSTEM, PW_SPRITE_TERMINAL},
-    {L"MihawkBrowser", L"MihawkBrowser.exe", NULL, L"MihawkBrowser.lnk", CSIDL_COMMON_DESKTOPDIRECTORY, PW_SPRITE_BROWSER},
 };
 
 static inline BOOL pw_taskbar_sprites_apply(UINT dpi) { return dpi == 96; }
