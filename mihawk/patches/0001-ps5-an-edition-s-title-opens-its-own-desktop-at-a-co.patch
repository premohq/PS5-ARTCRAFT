+	/* An edition opens its own desktop at a cold start (proton_edition). Not when the start returns from a session
+	 * (a restart always carries cycle=, so a session that fails or is logged off never restarts itself), not in a
+	 * test run, and not when the last session did not end normally: the library shows why instead. */
+	void openEdition()
+	{
+		const ProtonEdition &edition = proton_edition();
+		if (edition.profile.empty() || ps5.frameBudget || proton_selftest_active() || proton_launch().requested ||
+			!sessionNote.empty())
+			return;
+		const auto chosen = std::find_if(games.begin(), games.end(), [&edition](const ProtonGame &game) {
+			return game.id == edition.profile; });
+		if (chosen == games.end() || !chosen->complaint.empty()) {
+			proton_say("edition: %s cannot open %s: %s", edition.name.c_str(), edition.profile.c_str(),
+				chosen == games.end() ? "no such library entry" : chosen->complaint.c_str());
+			return;
+		}
+		proton_say("edition: %s opens %s at a cold start", edition.name.c_str(), chosen->id.c_str());
+		proton_queue_restart(&*chosen, proton_launch().cycle, "edition");
+		quit = true;
 	}
 
