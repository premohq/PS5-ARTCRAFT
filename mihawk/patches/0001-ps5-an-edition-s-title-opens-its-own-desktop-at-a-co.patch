 	char id[65];
diff --git a/ps5/src/proton_launch.h b/ps5/src/proton_launch.h
index 19ee185..543e715 100644
--- a/ps5/src/proton_launch.h
+++ b/ps5/src/proton_launch.h
@@ -60,8 +60,28 @@ struct ProtonLaunch {
 	bool arguments_override{ false };
 	/* ended=<reason>: why the last session ended, when it failed (native/proton_wine.cpp fail), for the launcher. */
 	std::string ended;
+	/* The start carried a launch request (profile=, path=, cycle=, env=, args= or ended=; a restart always writes
+	 * cycle=). False: a cold start, from the home screen, or a title update's first start. */
+	bool requested{ false };
 };
 
+/* An edition of this title: <title folder>/edition.json, read once (PS5-ARTCRAFT writes ArtCraft's).
+ *
+ *   {"name": "ArtCraft", "profile": "artcraft", "hide_mihawk_desktop": true, "browser_shortcut": false}
+ *
+ * profile: the library entry a cold start opens at once instead of showing the library, and the one the guided
+ * setup's first session prepares. A start that returns from a session (cycle=) shows the library as before, so a
+ * session that fails or is logged off never restarts itself. hide_mihawk_desktop: the library does not list Mihawk
+ * OS's own desktop. browser_shortcut: false keeps MihawkBrowser's shortcut off the desktops. Without the file, or
+ * with one that does not read, nothing changes. */
+struct ProtonEdition {
+	std::string name;
+	std::string profile;
+	bool hide_mihawk_desktop{ false };
+	bool browser_shortcut{ true };
+};
+const ProtonEdition &proton_edition();
+
 /* Present while a session runs (native/proton_wine.cpp): written at its start, removed when it ends through the title.
  * One the launcher finds is a session that crashed, froze or lost power. Holds the session's game name. */
 #define PROTON_SESSION_MARKER "/app0/session-running"
