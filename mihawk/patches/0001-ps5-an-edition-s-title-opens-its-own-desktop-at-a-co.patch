+const ProtonEdition &proton_edition()
+{
+	static const ProtonEdition edition = [] {
+		ProtonEdition read;
+		const std::string path = proton_title_path("/app0/edition.json");
+		FILE *file = fopen(path.c_str(), "rb");
+		if (!file) {
+			return read;
+		}
+		std::string text;
+		char buffer[4096];
+		size_t got = 0;
+		while ((got = fread(buffer, 1, sizeof(buffer), file)) > 0) {
+			text.append(buffer, got);
+		}
+		fclose(file);
+		try {
+			const nlohmann::json json = nlohmann::json::parse(text);
+			auto word = [&json](const char *key, std::string &into) {
+				auto found = json.find(key);
+				if (found != json.end() && found->is_string()) into = trim(found->get<std::string>());
+			};
+			auto flag = [&json](const char *key, bool &into) {
+				auto found = json.find(key);
+				if (found != json.end() && found->is_boolean()) into = found->get<bool>();
+			};
+			word("name", read.name);
+			word("profile", read.profile);
+			flag("hide_mihawk_desktop", read.hide_mihawk_desktop);
+			flag("browser_shortcut", read.browser_shortcut);
+		} catch (const std::exception &error) {
+			proton_say("edition: %s is not readable json (%s); none applies", path.c_str(), error.what());
+			return ProtonEdition();
+		}
+		proton_say("edition: %s, profile %s, Mihawk OS desktop %s, browser shortcut %s", read.name.c_str(),
+			read.profile.empty() ? "(none)" : read.profile.c_str(), read.hide_mihawk_desktop ? "hidden" : "listed",
+			read.browser_shortcut ? "kept" : "left out");
+		return read;
+	}();
+	return edition;
+}
