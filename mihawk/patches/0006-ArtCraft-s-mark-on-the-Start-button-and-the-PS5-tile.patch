+        {0x3f5fe0, -0.995523980, +0.094509286, -0.943978310, -0.330007501},
+        {0x8b5cf6, -0.925413362, -0.378959245, -0.682489150, -0.730895725},
+        {0xe0368f, -0.643301696, -0.765612780, -0.264649951, -0.964344546}
